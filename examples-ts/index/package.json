{
  "name": "llama-chat",
  "version": "0.1.0",
  "description": "Demo for LlamaCloud Index in TypeScript",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "echo \"There are no tests\"",
    "start": "pnpm exec tsx src/index.ts",
    "lint": "eslint ./src/",
    "format": "prettier --write ./src/",
    "build": "tsc",
    "dev": "pnpm exec tsx --watch src/index.ts"
