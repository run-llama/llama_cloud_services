  "keywords": [
    "ai",
    "rag",
    "retrieval",
    "pipeline",
    "llms",
    "chatbot"
  ],
  "author": "LlamaIndex",
  "license": "MIT",
  "packageManager": "pnpm@10.12.4",
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/figlet": "^1.7.0",
    "@types/node": "^24.1.0",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "jiti": "^2.5.1",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.50.0"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.0",
    "ai": "^5.0.52",
    "consola": "^3.4.2",
    "dotenv": "^17.2.1",
    "figlet": "^1.8.2",
    "llama-cloud-services": "link:../../ts/llama_cloud_services",
    "picocolors": "^1.1.1",
    "zod": "^4.6.6"
  },
  "pnpm": {
    "overrides": {
      "ai@<5.0.52": "^5.0.52",
      "@ai-sdk/provider-utils@<3.0.28": "^3.0.28",
      "@humanfs/node@<0.16.8": "^0.16.8",
      "ajv@<6.14.0": "^6.14.0",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
      "flatted@<3.4.2": "^3.4.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "jsondiffpatch@<0.7.6": "^0.7.6",
      "minimatch@<3.1.4": "^3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "nanoid@<3.3.18": "^3.3.18",
      "picomatch@<2.3.2": "^2.3.2",
      "zod@<4.6.6": "^4.6.6"
